# ================================================================
#  LingoLens AI – Produktion (netcup Webhosting, lingolens.caryssa.at)
#  Als ".env" in den App-Ordner auf dem Server kopieren und ausfüllen.
#  Diese Datei NIE mit echten Keys committen.
# ================================================================

APP_NAME="LingoLens AI"
APP_ENV=production
# Lokal erzeugen: php artisan key:generate --show
APP_KEY=
APP_DEBUG=false
APP_URL=https://lingolens.caryssa.at

APP_LOCALE=de
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=de_AT

APP_MAINTENANCE_DRIVER=file
BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=daily
LOG_DAILY_DAYS=14
LOG_LEVEL=warning

# --- Datenbank -------------------------------------------------
# Einfachste Variante: SQLite (Datei liegt in database/, außerhalb von public/)
DB_CONNECTION=sqlite

# Alternative: MariaDB aus Plesk (Datenbanken > Datenbank hinzufügen)
# DB_CONNECTION=mariadb
# DB_HOST=localhost
# DB_PORT=3306
# DB_DATABASE=
# DB_USERNAME=
# DB_PASSWORD=

# --- Sessions, Cache, Queue ------------------------------------
SESSION_DRIVER=database
SESSION_LIFETIME=240
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
SESSION_SECURE_COOKIE=true

CACHE_STORE=database
QUEUE_CONNECTION=database
FILESYSTEM_DISK=local
BROADCAST_CONNECTION=log

# --- E-Mail (Link bei "Passwort vergessen") --------------------
# Postfach in Plesk anlegen (E-Mail > E-Mail-Adresse erstellen), z. B. noreply@caryssa.at.
# SMTP-Server steht im netcup CCP / in Plesk unter "E-Mail-Einstellungen" (z. B. mxXXXXXX.netcup.net).
MAIL_MAILER=smtp
MAIL_SCHEME=smtps
MAIL_HOST=
MAIL_PORT=465
MAIL_USERNAME=noreply@caryssa.at
MAIL_PASSWORD=
MAIL_FROM_ADDRESS="noreply@caryssa.at"
MAIL_FROM_NAME="${APP_NAME}"

VITE_APP_NAME="${APP_NAME}"

# --- LingoLens AI ----------------------------------------------
# Google Cloud Vision (Handschrift-Erkennung) – API-Key auf "Cloud Vision API" beschränken
GOOGLE_VISION_API_KEY=
# OpenAI (KI-Korrektur) – Budget-Limit im OpenAI-Dashboard setzen!
OPENAI_API_KEY=
# gpt-4o wird von OpenAI am 14.01.2027 abgeschaltet – rechtzeitig umstellen.
OPENAI_MODEL=gpt-4o

# false = echte APIs (Keys oben nötig), true = Beispieltexte
LINGOLENS_DEMO_MODE=false
LINGOLENS_DEMO_STEP_DELAY_MS=0

# Analyse direkt nach dem Upload starten (PHP-FPM). Der Cronjob bleibt als Absicherung.
LINGOLENS_PROCESS_AFTER_RESPONSE=true

# Kostenschutz: Texte pro Schüler und Tag (0 = unbegrenzt)
LINGOLENS_DAILY_SCAN_LIMIT=20

# Zugangscode für die Registrierung (leer = jeder kann sich registrieren)
LINGOLENS_REGISTRATION_CODE=

LINGOLENS_MATURA_DATE=2027-05-05

# --- Impressum & Datenschutz (Pflicht vor dem Go-live) ---------
# Medieninhaber:in / Betreiber:in – wird auf /impressum und /datenschutz angezeigt
LEGAL_NAME=
LEGAL_STREET=
LEGAL_CITY="1010 Wien"
LEGAL_COUNTRY=Österreich
LEGAL_EMAIL=
LEGAL_PHONE=
# Nur bei gewerblichem Betrieb ausfüllen (sonst leer lassen)
LEGAL_BUSINESS_PURPOSE=
LEGAL_VAT_ID=
LEGAL_REGISTER_NUMBER=
LEGAL_REGISTER_COURT=
LEGAL_AUTHORITY=
LEGAL_CHAMBER=
# Stand der Rechtstexte (bei Änderungen anpassen)
LEGAL_UPDATED_AT=2026-10-16

# Google Vision EU-Endpunkt: Daten bleiben in der EU
GOOGLE_VISION_ENDPOINT=https://eu-vision.googleapis.com
